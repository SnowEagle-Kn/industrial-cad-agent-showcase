{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wishcad:source-manifest:1.2",
  "title": "Versioned source-manifest, including old file identities and explicit locators",
  "type": "object",
  "properties": {
    "schema": {
      "const": "wishcad.source-manifest.v1.2"
    },
    "kind": {
      "const": "source_manifest"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "$ref": "urn:wishcad:cognition:common:1#/$defs/id"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "locators": {
            "type": "array",
            "items": {
              "$ref": "urn:wishcad:cognition:common:1#/$defs/locator"
            },
            "minItems": 1
          },
          "usage_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "source_id",
          "path",
          "sha256",
          "bytes",
          "locators",
          "usage_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "file_count": {
      "type": "integer",
      "minimum": 1
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "kind",
    "recorded_at",
    "files",
    "file_count",
    "content_sha256"
  ],
  "additionalProperties": false
}
