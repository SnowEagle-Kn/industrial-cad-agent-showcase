{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wishcad:scene-cognition:1",
  "title": "Projection of cognition plus existing ordinary-task scene bindings; existing authorization and rendering contracts also required",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_version": {
      "type": "string",
      "minLength": 1
    },
    "candidate_sha256": {
      "$ref": "urn:wishcad:cognition:common:1#/$defs/digest"
    },
    "cognition_schema": {
      "const": "wishcad.scene-cognition.v1"
    },
    "object_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": {
            "$ref": "urn:wishcad:cognition:common:1#/$defs/id"
          },
          "object_id": {
            "$ref": "urn:wishcad:cognition:common:1#/$defs/id"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "feature_id": {
                  "$ref": "urn:wishcad:cognition:common:1#/$defs/id"
                },
                "actual_value": {
                  "$ref": "urn:wishcad:cognition:common:1#/$defs/scalar"
                },
                "unit": {
                  "$ref": "urn:wishcad:cognition:common:1#/$defs/unit"
                },
                "source_refs": {
                  "$ref": "urn:wishcad:cognition:common:1#/$defs/source_refs"
                }
              },
              "required": [
                "feature_id",
                "actual_value",
                "unit",
                "source_refs"
              ],
              "additionalProperties": false
            }
          },
          "reference_frame_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "source_to_scene": {
            "$ref": "urn:wishcad:cognition:common:1#/$defs/transform"
          },
          "disposition": {
            "enum": [
              "EXPRESSED",
              "CHECK_VIEW",
              "NOT_APPLICABLE",
              "UNKNOWN"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "check_view_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "node_id",
          "object_id",
          "features",
          "reference_frame_id",
          "source_to_scene",
          "disposition",
          "reason",
          "check_view_ids"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "NOT_APPLICABLE"
                }
              },
              "required": [
                "disposition"
              ]
            },
            "then": {
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "CHECK_VIEW"
                }
              },
              "required": [
                "disposition"
              ]
            },
            "then": {
              "properties": {
                "check_view_ids": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "run_id",
    "candidate_id",
    "candidate_version",
    "candidate_sha256",
    "cognition_schema",
    "object_bindings"
  ],
  "additionalProperties": false
}
