{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wishcad:brief-entry:1.2",
  "title": "Projection of new brief entry fields; existing Q1-Q11 contract also applies",
  "type": "object",
  "properties": {
    "schema": {
      "const": "wishcad.brief.v1.2"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "entry_slots": {
      "type": "object",
      "properties": {
        "goal": {
          "$ref": "urn:wishcad:cognition:common:1#/$defs/slot"
        },
        "object_context": {
          "$ref": "urn:wishcad:cognition:common:1#/$defs/slot"
        },
        "constraints": {
          "$ref": "urn:wishcad:cognition:common:1#/$defs/slot"
        }
      },
      "required": [
        "goal",
        "object_context",
        "constraints"
      ],
      "additionalProperties": false
    },
    "delivery_scope": {
      "enum": [
        "CONCEPT",
        "DETAIL_DESIGN",
        "IMPLEMENTABLE",
        "RECONSTRUCTION",
        "UNKNOWN"
      ]
    },
    "delivery_scope_source_refs": {
      "$ref": "urn:wishcad:cognition:common:1#/$defs/source_refs"
    },
    "evidence_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_id": {
            "$ref": "urn:wishcad:cognition:common:1#/$defs/id"
          },
          "slot": {
            "enum": [
              "goal",
              "object_context",
              "constraints",
              "delivery_scope"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "dependency_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "OPEN",
              "ANSWERED"
            ]
          },
          "answer": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "source_refs": {
            "$ref": "urn:wishcad:cognition:common:1#/$defs/source_refs"
          }
        },
        "required": [
          "question_id",
          "slot",
          "question",
          "dependency_ids",
          "status",
          "answer",
          "source_refs"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ANSWERED"
                }
              }
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "string",
                  "minLength": 1
                },
                "source_refs": {
                  "minItems": 1
                }
              }
            },
            "else": {
              "properties": {
                "answer": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "run_id",
    "revision",
    "entry_slots",
    "delivery_scope",
    "delivery_scope_source_refs",
    "evidence_gaps"
  ],
  "additionalProperties": false
}
