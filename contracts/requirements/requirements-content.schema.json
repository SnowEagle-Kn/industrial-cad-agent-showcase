{
  "type": "object",
  "properties": {
    "schema": {
      "const": "wishcad.requirements-content.v1"
    },
    "binding": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "brief_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "requirements_revision": {
          "type": "string",
          "minLength": 1
        },
        "rules_revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "task_id",
        "run_id",
        "revision",
        "brief_sha256",
        "source_manifest_sha256",
        "requirements_revision",
        "rules_revision"
      ],
      "additionalProperties": false
    },
    "requirements_check": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "GOAL",
              "BOUNDARY",
              "PROCESS",
              "CONSTRAINTS",
              "DELIVERY"
            ]
          },
          "status": {
            "enum": [
              "SUPPORTED",
              "UNKNOWN",
              "CONFLICT",
              "ASSUMED"
            ]
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "source_refs": {
            "$ref": "urn:wishcad:cognition:common:1#/$defs/source_refs"
          },
          "gap": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "kind",
          "status",
          "requirement_ids",
          "source_refs",
          "gap"
        ],
        "additionalProperties": false
      },
      "minItems": 5,
      "uniqueItems": true
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "dependency_id": {
                  "type": "string",
                  "minLength": 1
                },
                "check_kind": {
                  "enum": [
                    "GOAL",
                    "BOUNDARY",
                    "PROCESS",
                    "CONSTRAINTS",
                    "DELIVERY"
                  ]
                },
                "requirement_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 0,
                  "uniqueItems": true
                },
                "required": {
                  "type": "boolean"
                },
                "nonblocking_reason": {
                  "type": "string"
                }
              },
              "required": [
                "dependency_id",
                "check_kind",
                "requirement_ids",
                "required",
                "nonblocking_reason"
              ],
              "additionalProperties": false
            },
            "minItems": 5,
            "uniqueItems": true
          }
        },
        "required": [
          "action_id",
          "dependencies"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "process_contract": {
      "type": "object",
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "$ref": "urn:wishcad:cognition:common:1#/$defs/source_refs"
        },
        "states": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "state_id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "source_refs": {
                "$ref": "urn:wishcad:cognition:common:1#/$defs/source_refs"
              }
            },
            "required": [
              "state_id",
              "description",
              "source_refs"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "transition_id": {
                "type": "string",
                "minLength": 1
              },
              "from_state": {
                "type": "string",
                "minLength": 1
              },
              "to_state": {
                "type": "string",
                "minLength": 1
              },
              "actor": {
                "type": "string",
                "minLength": 1
              },
              "support_before": {
                "type": "string",
                "minLength": 1
              },
              "support_during": {
                "type": "string",
                "minLength": 1
              },
              "support_after": {
                "type": "string",
                "minLength": 1
              },
              "release_condition": {
                "type": "string",
                "minLength": 1
              },
              "source_refs": {
                "$ref": "urn:wishcad:cognition:common:1#/$defs/source_refs"
              }
            },
            "required": [
              "transition_id",
              "from_state",
              "to_state",
              "actor",
              "support_before",
              "support_during",
              "support_after",
              "release_condition",
              "source_refs"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "contract_id",
        "revision",
        "source_refs",
        "states",
        "transitions"
      ],
      "additionalProperties": false
    },
    "delivery_contract": {
      "type": "object",
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "$ref": "urn:wishcad:cognition:common:1#/$defs/source_refs"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item_id": {
                "type": "string",
                "minLength": 1
              },
              "applicable": {
                "type": "boolean"
              },
              "applicability_reason": {
                "type": "string"
              },
              "stages": {
                "type": "array",
                "items": {
                  "enum": [
                    "PRESELECTION",
                    "POSTSELECTION"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "view_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "state_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "feature_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0,
                "uniqueItems": true
              }
            },
            "required": [
              "item_id",
              "applicable",
              "applicability_reason",
              "stages",
              "view_ids",
              "state_ids",
              "feature_ids"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "contract_id",
        "revision",
        "source_refs",
        "items"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "binding",
    "requirements_check",
    "actions",
    "process_contract",
    "delivery_contract"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wishcad:c01-r2:requirements-content.schema.json"
}
